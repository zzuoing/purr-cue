{
  "name": "purrcue",
  "version": "2.0.3",
  "description": "PurrCue — a little cat for timely reminders",
  "author": "zzuoing",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "src/entry.cjs",
  "desktopName": "desktop-reminder.desktop",
  "homepage": "https://github.com/zzuoing/purr-cue",
  "repository": {
    "type": "git",
    "url": "https://github.com/zzuoing/purr-cue.git"
  },
  "bugs": {
    "url": "https://github.com/zzuoing/purr-cue/issues"
  },
  "scripts": {
    "postinstall": "node scripts/prepare-vendor.cjs",
    "prestart": "node scripts/prepare-vendor.cjs",
    "prepack": "node scripts/prepare-vendor.cjs",
    "predist:win": "node scripts/prepare-vendor.cjs",
    "predist:mac": "node scripts/prepare-vendor.cjs",
    "predist:linux": "node scripts/prepare-vendor.cjs",
    "predist": "node scripts/prepare-vendor.cjs",
    "start": "electron .",
    "preview": "electron . --preview",
    "test": "node --test test/*.test.cjs",
    "check": "node scripts/check.cjs",
    "version:tag": "node scripts/set-version.cjs",
    "verify:animation": "electron scripts/verify-animation.cjs",
    "verify:app": "electron scripts/smoke.cjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "cli": "node bin/purrcue.cjs"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "flatpickr": "4.6.13"
  },
  "build": {
    "appId": "com.zzuoing.desktop-reminder",
    "productName": "PurrCue",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "asar": true,
    "artifactName": "PurrCue-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/cat-head.ico",
      "executableName": "PurrCue",
      "extraFiles": [
        {
          "from": "bin/purrcue.cmd",
          "to": "purrcue.cmd"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "en_US",
        "zh_CN",
        "ja_JP",
        "ko_KR"
      ],
      "displayLanguageSelector": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "extendInfo": {
        "CFBundleDevelopmentRegion": "en",
        "CFBundleLocalizations": [
          "en",
          "zh-Hans",
          "ja",
          "ko"
        ]
      },
      "icon": "assets/app-icon.png",
      "extraFiles": [
        {
          "from": "bin/purrcue",
          "to": "purrcue"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "executableName": "purrcue-desktop",
      "syncDesktopName": true,
      "maintainer": "zzuoing <zzuoing@users.noreply.github.com>",
      "category": "Utility",
      "icon": "assets/app-icon.png",
      "extraFiles": [
        {
          "from": "bin/purrcue",
          "to": "purrcue"
        }
      ]
    },
    "extraResources": [
      {
        "from": "bin/purrcue.cjs",
        "to": "cli/purrcue.cjs"
      }
    ]
  },
  "bin": {
    "purrcue": "bin/purrcue.cjs"
  }
}
